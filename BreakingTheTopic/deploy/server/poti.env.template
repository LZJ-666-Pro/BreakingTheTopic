# /opt/poti/poti.env 模板 —— 服务器上创建 /opt/poti/poti.env 后逐项填写
# 所有值取自本地 deploy/secrets.env（该文件已被 gitignore，严禁把真实值提交进仓库）
# 填完执行：chmod 600 /opt/poti/poti.env

# ---- 核心密钥（与 secrets.env 同名项一一对应）----
JWT_SECRET=<复制 secrets.env 的 JWT_SECRET>
INTERNAL_TOKEN=<复制 secrets.env 的 INTERNAL_TOKEN>
DB_PASSWORD=<复制 secrets.env 的 DB_PASSWORD>

# ---- 微信小程序凭据 ----
WX_APPID=<复制 secrets.env 的 WX_APPID>
WX_SECRET=<复制 secrets.env 的 WX_SECRET>
# ⚠️ 部署后若小程序登录失败，第一时间核对 WX_SECRET 是否为微信公众平台「开发设置」当前有效值

# ---- 智谱 AI（poti-agent 用）----
AI_API_KEY=<复制 secrets.env 的 AI_API_KEY>

# ---- 微信支付（个人开发者保持模拟支付）----
WX_PAY_ENABLED=false

# ---- 数据库连接（Spring Boot 环境变量覆盖，作用于全部服务）----
SPRING_DATASOURCE_USERNAME=root
# 与上面 DB_PASSWORD 填同一个值
SPRING_DATASOURCE_PASSWORD=<同 DB_PASSWORD>

# ---- 头像访问前缀（poti-user 用；Phase B 换域名时同步改这里）----
AVATAR_URL_PREFIX=http://124.220.203.95:8200

# ---- 搜索降级（服务器不装 ES，search 服务自动走数据库 LIKE 检索）----
ELASTICSEARCH_ENABLED=false
