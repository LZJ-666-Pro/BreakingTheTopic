<view class="page">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">反馈类型</text>
      <view class="type-tabs">
        <view class="type-tab {{currentType === 'bug' ? 'active' : ''}}" data-type="bug" bindtap="selectType">问题反馈</view>
        <view class="type-tab {{currentType === 'feature' ? 'active' : ''}}" data-type="feature" bindtap="selectType">功能建议</view>
        <view class="type-tab {{currentType === 'other' ? 'active' : ''}}" data-type="other" bindtap="selectType">其他</view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">反馈内容</text>
      <textarea 
        class="form-textarea" 
        placeholder="请详细描述您的问题或建议，至少10个字" 
        value="{{content}}"
        bindinput="onContentInput"
        maxlength="500"
      />
      <text class="form-count">{{content.length}}/500</text>
    </view>

    <view class="form-item">
      <text class="form-label">联系方式<text class="optional">（选填）</text></text>
      <input 
        class="form-input" 
        placeholder="方便我们联系您，手机号或邮箱" 
        value="{{contact}}"
        bindinput="onContactInput"
      />
    </view>

    <button class="form-btn" loading="{{submitting}}" bindtap="submitFeedback">提交反馈</button>
  </view>

  <view class="history-card" wx:if="{{feedbackList.length > 0}}">
    <view class="card-header">
      <text class="card-title">我的反馈</text>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{feedbackList}}" wx:key="id">
        <view class="item-top">
          <text class="item-type">{{item.type === 'bug' ? '问题反馈' : item.type === 'feature' ? '功能建议' : '其他'}}</text>
          <view class="item-actions">
            <text class="item-status {{item.status === 1 ? 'done' : ''}}">{{item.status === 1 ? '已回复' : '待处理'}}</text>
            <text class="item-delete" data-id="{{item.id}}" bindtap="deleteFeedback">删除</text>
          </view>
        </view>
        <text class="item-content">{{item.content}}</text>
        <view class="item-reply" wx:if="{{item.reply}}">
          <text class="reply-text">回复：{{item.reply}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
