.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-section {
  background: #fff;
  padding: 20rpx;
}

.search-results {
  background: #fff;
  margin-top: 20rpx;
  padding: 20rpx;
}

.result-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.add-btn {
  padding: 12rpx 24rpx;
  background: #FFB800;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.scroll-view {
  height: calc(100vh - 300rpx);
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}

.friend-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 20rpx;
  margin-bottom: 2rpx;
}

.friend-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.friend-info {
  flex: 1;
  min-width: 0;
}

.friend-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.friend-stats {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-item {
  margin-right: 8rpx;
}

.stat-divider {
  margin: 0 8rpx;
  color: #e0e0e0;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
  margin-left: auto;
  margin-right: 16rpx;
}

.last-message {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-right {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.chat-btn {
  position: relative;
  padding: 10rpx 20rpx;
  background: #fff;
  color: #07c160;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid #07c160;
}

.chat-btn:active {
  background: #f0fff4;
  transform: scale(0.98);
}

.unread-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 20rpx;
  height: 20rpx;
  background: #ff4d4f;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 3rpx;
  font-size: 14rpx;
  color: #fff;
  border: 1rpx solid #fff;
}

.clear-btn {
  padding: 10rpx 20rpx;
  background: #fff;
  color: #ff9800;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid #ff9800;
}

.clear-btn:active {
  background: #fff8e1;
  transform: scale(0.98);
}

.delete-btn {
  padding: 10rpx 20rpx;
  background: #fff;
  color: #ff4444;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid #ff4444;
}

.delete-btn:active {
  background: #fff5f5;
  transform: scale(0.98);
}

.request-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 20rpx;
  margin-bottom: 2rpx;
}

.request-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.request-info {
  flex: 1;
}

.request-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.request-message {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.accept-btn {
  padding: 12rpx 24rpx;
  background: #FFB800;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.reject-btn {
  padding: 12rpx 24rpx;
  background: #999;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.sent-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 20rpx;
  margin-bottom: 2rpx;
}

.sent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.sent-info {
  flex: 1;
}

.sent-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.sent-status {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.dialog-content {
  padding: 32rpx;
}

.message-input {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.conversation-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 20rpx;
  margin-bottom: 2rpx;
}

.conversation-item:active {
  background: #f5f5f5;
}

.conversation-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.conversation-info {
  flex: 1;
  min-width: 0;
}

.conversation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.conversation-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.conversation-time {
  font-size: 24rpx;
  color: #999;
}

.conversation-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conversation-message {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.unread-badge {
  min-width: 36rpx;
  height: 36rpx;
  background: #ff4d4f;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.unread-badge text {
  font-size: 20rpx;
  color: #fff;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #f0f1f2 0%, #f8f9fa 100%);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.invite-btn {
  background: linear-gradient(135deg, #fff9e6 0%, #ffffff 100%);
  border-color: #ffd666;
}

.invite-btn .btn-text {
  color: #d48806;
}

.recommend-btn {
  background: linear-gradient(135deg, #f0fff4 0%, #ffffff 100%);
  border-color: #95de64;
}

.recommend-btn .btn-text {
  color: #389e0d;
}

.code-btn {
  background: linear-gradient(135deg, #e6f7ff 0%, #ffffff 100%);
  border-color: #69c0ff;
}

.code-btn .btn-text {
  color: #096dd9;
}

.invite-dialog-content {
  padding: 40rpx 32rpx;
  text-align: center;
}

.invite-code-display {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFB800;
  letter-spacing: 8rpx;
  padding: 40rpx;
  background: #fff9e6;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.invite-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.invite-actions {
  display: flex;
  justify-content: center;
}

.copy-btn {
  padding: 16rpx 48rpx;
  background: #FFB800;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.copy-btn::after {
  border: none;
}

.recommend-scroll {
  max-height: 600rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recommend-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.recommend-info {
  flex: 1;
}

.recommend-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.recommend-stats {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.mutual-friends {
  margin-left: 16rpx;
  color: #1890ff;
}

.code-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 4rpx;
}
