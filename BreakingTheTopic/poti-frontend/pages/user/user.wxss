page {
  min-height: 100vh;
  background: #F6F7F9;
}

.page {
  min-height: 100vh;
}

.header {
  position: relative;
  padding: 32rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
}

.profile-section {
  background: linear-gradient(180deg, #D9E6F8 0%, #ECF3FB 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(93, 130, 180, 0.12);
}

.profile-top {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #F0F0F0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
  background: #fff;
}

.avatar {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.level-badge {
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.user-tag {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A94A6;
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.stats-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-top: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 130, 180, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #EEF1F5;
}

.stat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
}

.stat-number {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #8A94A6;
}

.content {
  padding: 24rpx 32rpx;
}

.function-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
}

.function-grid {
  display: flex;
  flex-wrap: wrap;
}

.function-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.function-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.function-icon.train {
  background: rgba(255, 107, 107, 0.1);
}

.function-icon.interview {
  background: rgba(7, 193, 96, 0.1);
}

.function-icon.answer {
  background: rgba(24, 144, 255, 0.1);
}

.function-icon.favorite {
  background: rgba(255, 149, 0, 0.1);
}

.function-icon.wrong {
  background: rgba(250, 81, 81, 0.1);
}

.function-icon.history {
  background: rgba(123, 97, 255, 0.1);
}

.function-icon.rank {
  background: rgba(255, 215, 0, 0.15);
}

.function-icon.friends {
  background: rgba(255, 184, 0, 0.15);
}

.function-icon.achieve {
  background: rgba(235, 47, 150, 0.1);
}

.function-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
}

.unread-dot {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4444;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #fff;
}

.function-item {
  position: relative;
}

.service-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-name {
  font-size: 28rpx;
  color: #333;
}

.service-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.service-tip {
  font-size: 24rpx;
  color: #999;
}

.logout-item {
  margin-top: 16rpx;
}

.logout-text {
  color: #333;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.footer-links {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.footer-link {
  font-size: 24rpx;
  color: #666;
}

.footer-divider {
  margin: 0 16rpx;
  color: #DDD;
}

.edit-form {
  padding: 20rpx;
}

.gender-select {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.gender-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}
