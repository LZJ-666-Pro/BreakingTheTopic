<view class="page">
  <view class="header">
    <view class="profile-section">
      <view class="profile-top">
        <view class="avatar-wrap" bindtap="chooseAvatar">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="profile-info">
          <view class="name-row">
            <text class="profile-name">{{userInfo.nickname || '面试鸭8384'}}</text>
            <view class="level-badge">Lv1</view>
            <view class="user-tag">普通用户</view>
          </view>
          <text class="profile-id">ID: {{userInfo.id || userId}}</text>
        </view>
        <view class="edit-btn" bindtap="editProfile">
          <van-icon name="edit" size="18px" color="rgba(255,255,255,0.8)" />
        </view>
      </view>
      
      <view class="stats-card">
        <view class="stat-item" bindtap="goToHistory">
          <text class="stat-number">{{statistics.totalQuestionCount}}</text>
          <text class="stat-label">累计刷题</text>
        </view>
        <view class="stat-item" bindtap="goToCorrect">
          <text class="stat-number correct">{{statistics.todayCount || 0}}</text>
          <text class="stat-label">今日刷题</text>
        </view>
        <view class="stat-item" bindtap="goToWrongbook">
          <text class="stat-number wrong">{{statistics.wrongbookCount || 0}}</text>
          <text class="stat-label">错题</text>
        </view>
        <view class="stat-item" bindtap="goToFavorite">
          <text class="stat-number favorite">{{statistics.favoriteCount}}</text>
          <text class="stat-label">收藏</text>
        </view>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="function-card">
      <view class="function-grid">
        <view class="function-item" bindtap="goToTrain">
          <view class="function-icon train">
            <van-icon name="fire-o" size="24px" color="#FF6B6B" />
          </view>
          <text class="function-name">面试特训营</text>
        </view>
        <view class="function-item" bindtap="goToInterview">
          <view class="function-icon interview">
            <van-icon name="chat-o" size="24px" color="#07C160" />
          </view>
          <text class="function-name">1v1模拟面试</text>
        </view>
        <view class="function-item" bindtap="goToAnswer">
          <view class="function-icon answer">
            <van-icon name="comment-o" size="24px" color="#1890FF" />
          </view>
          <text class="function-name">我的回答</text>
        </view>
        <view class="function-item" bindtap="goToFavorite">
          <view class="function-icon favorite">
            <van-icon name="star-o" size="24px" color="#FF9500" />
          </view>
          <text class="function-name">题目收藏</text>
        </view>
        <view class="function-item" bindtap="goToWrongbook">
          <view class="function-icon wrong">
            <van-icon name="warning-o" size="24px" color="#FA5151" />
          </view>
          <text class="function-name">错题本</text>
        </view>
        <view class="function-item" bindtap="goToHistory">
          <view class="function-icon history">
            <van-icon name="clock-o" size="24px" color="#7B61FF" />
          </view>
          <text class="function-name">刷题记录</text>
        </view>
        <view class="function-item" bindtap="goToRank">
          <view class="function-icon rank">
            <van-icon name="medal-o" size="24px" color="#FFD700" />
          </view>
          <text class="function-name">排行榜</text>
        </view>
        <view class="function-item" bindtap="goToFriends">
          <view class="function-icon friends">
            <van-icon name="friends-o" size="24px" color="#FFB800" />
          </view>
          <text class="function-name">好友管理</text>
          <view wx:if="{{unreadCount > 0}}" class="unread-dot">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <view class="function-item" bindtap="goToAchieve">
          <view class="function-icon achieve">
            <van-icon name="gem-o" size="24px" color="#EB2F96" />
          </view>
          <text class="function-name">成就中心</text>
        </view>
      </view>
    </view>

    <view class="service-card">
      <view class="service-item" bindtap="joinGroup">
        <view class="service-left">
          <van-icon name="friends-o" size="20px" color="#07C160" />
          <text class="service-name">加交流群</text>
        </view>
        <view class="service-right">
          <text class="service-tip">获取最新资讯</text>
          <van-icon name="arrow" size="14px" color="#C0C0C0" />
        </view>
      </view>
      <view class="service-item" bindtap="contactUs">
        <view class="service-left">
          <van-icon name="service-o" size="20px" color="#1890FF" />
          <text class="service-name">联系我们</text>
        </view>
        <view class="service-right">
          <van-icon name="arrow" size="14px" color="#C0C0C0" />
        </view>
      </view>
      <view class="service-item" bindtap="goToSetting">
        <view class="service-left">
          <van-icon name="setting-o" size="20px" color="#666" />
          <text class="service-name">刷题设置</text>
        </view>
        <view class="service-right">
          <van-icon name="arrow" size="14px" color="#C0C0C0" />
        </view>
      </view>
      <view class="service-item" bindtap="goToFeedback">
        <view class="service-left">
          <van-icon name="comment-circle-o" size="20px" color="#FF9500" />
          <text class="service-name">意见反馈</text>
        </view>
        <view class="service-right">
          <van-icon name="arrow" size="14px" color="#C0C0C0" />
        </view>
      </view>
      <view class="service-item logout-item" bindtap="handleLogout">
        <view class="service-left">
          <van-icon name="revoke" size="20px" color="#FA5151" />
          <text class="service-name logout-text">退出登录</text>
        </view>
        <view class="service-right">
          <van-icon name="arrow" size="14px" color="#C0C0C0" />
        </view>
      </view>
    </view>

    <view class="footer">
      <text class="footer-text">网页版：poti.example.com</text>
      <text class="footer-text">小程序插件 v1.0.0</text>
      <view class="footer-links">
        <text class="footer-link" bindtap="goToAgreement">用户协议</text>
        <text class="footer-divider">|</text>
        <text class="footer-link" bindtap="goToPrivacy">隐私政策</text>
      </view>
    </view>

    <view style="height: 120rpx;"></view>
  </view>
</view>

<van-dialog use-slot title="编辑个人信息" show="{{ showEditDialog }}" show-cancel-button bind:confirm="confirmEdit" bind:cancel="cancelEdit" round>
  <view class="edit-form">
    <van-field label="昵称" value="{{editForm.nickname}}" bind:change="onNicknameChange" placeholder="请输入昵称" border="{{ false }}" />
    <van-field label="唯一ID" value="{{editForm.uniqueId}}" bind:change="onUniqueIdChange" placeholder="4-20位字母、数字、下划线" border="{{ false }}" />
    <van-field label="手机号" value="{{editForm.phone}}" bind:change="onPhoneChange" placeholder="请输入手机号" type="number" border="{{ false }}" />
    <van-field label="邮箱" value="{{editForm.email}}" bind:change="onEmailChange" placeholder="请输入邮箱" border="{{ false }}" />
    <view class="gender-select">
      <text class="gender-label">性别：</text>
      <van-radio-group value="{{ editForm.gender }}" bind:change="onGenderChange" direction="horizontal">
        <van-radio name="{{1}}">男</van-radio>
        <van-radio name="{{2}}">女</van-radio>
        <van-radio name="{{0}}">保密</van-radio>
      </van-radio-group>
    </view>
  </view>
</van-dialog>
