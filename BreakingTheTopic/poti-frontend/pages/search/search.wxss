page {
  min-height: 100vh;
  background: #F6F7F9;
}

.page {
  min-height: 100vh;
}

.header {
  background: #fff;
  padding: 60rpx 32rpx 40rpx;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #F0F0F0;
  position: relative;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

.search-btn {
  padding: 20rpx 36rpx;
  background: #fff;
  border-radius: 12rpx;
  flex-shrink: 0;
  border: 2rpx solid #333;
}

.search-btn text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.suggestions-wrap {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #F0F0F0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  max-height: 400rpx;
  overflow-y: auto;
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.content {
  padding: 24rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  margin-top: 16rpx;
  color: #999;
  font-size: 26rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #333;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.recommend-keywords {
  margin-top: 40rpx;
  width: 100%;
  padding: 0 32rpx;
}

.recommend-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.recommend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.recommend-item {
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.result-section {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.result-header {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-count {
  font-size: 26rpx;
  color: #999;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-tags {
  padding: 16rpx 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #07C160;
}

.result-list {
  padding: 0 28rpx;
}

.result-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s ease;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item:active {
  background: #fafafa;
}

.result-title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.result-content {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.result-type {
  padding: 6rpx 16rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.result-type.java {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.result-type.python {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.result-type.mysql {
  background: rgba(16, 174, 255, 0.1);
  color: #10AEFF;
}

.result-type.redis {
  background: rgba(250, 81, 81, 0.1);
  color: #FA5151;
}

.result-difficulty {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.difficulty-1 {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.difficulty-2 {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.difficulty-3 {
  background: rgba(250, 81, 81, 0.1);
  color: #FA5151;
}

.result-time {
  font-size: 22rpx;
  color: #999;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #07C160;
  font-size: 28rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #999;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  padding: 14rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s ease;
}

.history-tag:active {
  background: #e8e8e8;
  transform: scale(0.95);
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 14rpx 24rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.hot-keywords-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.keyword-tag {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.keyword-tag:active {
  background: #e8e8e8;
  transform: scale(0.95);
}

.recommend-list {
  display: flex;
  flex-direction: column;
}

.recommend-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s ease;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-item:active {
  background: #fafafa;
}

.recommend-content {
  flex: 1;
}

.recommend-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.recommend-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.recommend-type {
  color: #666;
}

.recommend-dot {
  margin: 0 8rpx;
}

.recommend-views {
  color: #999;
}

.hot-list {
  display: flex;
  flex-direction: column;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-content {
  flex: 1;
}

.hot-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.hot-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hot-type {
  font-size: 22rpx;
  color: #07C160;
}

.hot-views {
  font-size: 22rpx;
  color: #999;
}

.filter-sheet {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.filter-group {
  margin-bottom: 32rpx;
}

.filter-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.filter-option:active {
  background: #e8e8e8;
}

.filter-option.active {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-color: #07C160;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.filter-btn-reset,
.filter-btn-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.filter-btn-reset {
  background: #f5f5f5;
  color: #666;
}

.filter-btn-reset:active {
  background: #e8e8e8;
}

.filter-btn-confirm {
  background: #07C160;
  color: #fff;
}

.filter-btn-confirm:active {
  background: #06ad56;
  transform: scale(0.98);
}
