<view class="page" wx:if="{{camp}}">
  <!-- 营头部 -->
  <view class="hero">
    <view class="hero-emoji" style="background: {{camp.tint}};">{{camp.emoji}}</view>
    <view class="hero-title">{{camp.title}}</view>
    <view class="hero-subtitle">{{camp.subtitle}}</view>
    <view class="hero-chips">
      <text class="hero-chip">⏱ {{camp.totalDays}}天</text>
      <text class="hero-chip">{{camp.tag}}</text>
      <text class="hero-chip" wx:if="{{camp.joinCount > 0}}">👥 已有{{camp.joinText}}人加入</text>
      <text class="hero-chip" wx:else>👥 虚位以待，等你来打卡</text>
    </view>
  </view>

  <!-- 营介绍 -->
  <view class="card">
    <view class="card-title">营介绍</view>
    <text class="intro-text">{{camp.intro}}</text>
  </view>

  <!-- 适合人群 -->
  <view class="card">
    <view class="card-title">适合人群</view>
    <view class="line-item" wx:for="{{camp.audience}}" wx:key="*this">
      <text class="line-icon">✅</text>
      <text class="line-text">{{item}}</text>
    </view>
  </view>

  <!-- 内容亮点 -->
  <view class="card">
    <view class="card-title">内容亮点</view>
    <view class="line-item" wx:for="{{camp.highlights}}" wx:key="*this">
      <text class="line-icon">✨</text>
      <text class="line-text">{{item}}</text>
    </view>
  </view>

  <!-- 训练大纲 -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-title">训练大纲</text>
      <text class="card-extra">{{camp.progressDays}}/{{camp.totalDays}} 天已完成</text>
    </view>
    <view class="outline-item" wx:for="{{outlineVisible}}" wx:key="day">
      <view class="outline-day {{item.done ? 'done' : ''}}">
        {{item.done ? '✓' : item.day}}
      </view>
      <view class="outline-topic {{item.done ? 'done' : ''}}">第{{item.day}}天 · {{item.topic}}</view>
    </view>
    <view class="outline-toggle" bindtap="toggleOutline" wx:if="{{camp.outline.length > 7}}">
      {{outlineExpanded ? '收起 ▲' : '展开全部大纲 ▼'}}
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="btn-join" bindtap="joinCamp">
      {{camp.finished ? '查看总结' : (camp.joined ? '继续训练' : '立即加入')}}
    </view>
  </view>
</view>

<view wx:elif="{{loading}}" class="loading-page">加载中...</view>
