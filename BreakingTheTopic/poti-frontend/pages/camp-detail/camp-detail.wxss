.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 140rpx;
}

/* 营头部 */
.hero {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
}

.hero-emoji {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1B2B4B;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8A94A6;
}

.hero-chips {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  flex-wrap: wrap;
}

.hero-chip {
  font-size: 22rpx;
  color: #5A6478;
  background: #F3F5F9;
  padding: 8rpx 20rpx;
  border-radius: 22rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(27, 43, 75, 0.10);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1B2B4B;
  margin-bottom: 18rpx;
}

.card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.card-extra {
  font-size: 23rpx;
  color: #2979FF;
  font-weight: 600;
}

.intro-text {
  font-size: 27rpx;
  color: #5A6478;
  line-height: 1.8;
}

.line-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.line-item:last-child {
  margin-bottom: 0;
}

.line-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.line-text {
  font-size: 27rpx;
  color: #5A6478;
  line-height: 1.6;
}

/* 训练大纲 */
.outline-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F5F9;
}

.outline-item:last-of-type {
  border-bottom: none;
}

.outline-day {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F3F5F9;
  color: #8A94A6;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.outline-day.done {
  background: #EAF2FF;
  color: #2979FF;
  font-weight: 700;
}

.outline-topic {
  font-size: 27rpx;
  color: #1B2B4B;
  line-height: 1.5;
}

.outline-topic.done {
  color: #A8B0BF;
  text-decoration: line-through;
}

.outline-toggle {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  color: #2979FF;
  font-weight: 600;
  padding: 10rpx 0;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-join {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4F8BFF, #2979FF);
  border-radius: 44rpx;
  box-shadow: 0 12rpx 24rpx -12rpx rgba(41, 121, 255, 0.55);
}

.loading-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8A94A6;
}

.bottom-space {
  height: 20rpx;
}
