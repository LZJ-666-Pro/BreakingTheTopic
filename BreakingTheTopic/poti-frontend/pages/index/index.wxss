page {
  background: #F6F7F9;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  box-sizing: border-box;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-action {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #FA5151;
  border-radius: 14rpx;
  font-size: 18rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.main-scroll {
  flex: 1;
  margin-top: calc(88rpx + env(safe-area-inset-top));
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.continue-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.continue-content {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.continue-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.continue-desc {
  font-size: 24rpx;
  color: #999;
}

.banner-swiper {
  height: 300rpx;
  margin-bottom: 20rpx;
}

.banner-card {
  position: relative;
  height: 100%;
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  box-sizing: border-box;
}

.banner-decor {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.decor-circle-1 {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -60rpx;
  background: rgba(255, 255, 255, 0.8);
}

.decor-circle-2 {
  width: 120rpx;
  height: 120rpx;
  right: 60rpx;
  bottom: -30rpx;
  background: rgba(255, 255, 255, 0.6);
}

.decor-circle-3 {
  width: 80rpx;
  height: 80rpx;
  right: 180rpx;
  top: 40rpx;
  background: rgba(255, 255, 255, 0.4);
}

.banner-icon-wrap {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
}

.banner-icon {
  font-size: 100rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.15));
}

.banner-content {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 3;
  max-width: 65%;
}

.banner-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.banner-title {
  font-size: 38rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

.banner-action {
  display: flex;
  align-items: center;
}

.banner-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.banner-btn text {
  font-size: 26rpx;
  font-weight: 600;
}

.banner-fire {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 50%, #FFD23F 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.banner-fire .decor-circle-1 {
  animation: float1 3s ease-in-out infinite;
}

.banner-fire .decor-circle-2 {
  animation: float2 4s ease-in-out infinite;
}

.banner-fire .decor-circle-3 {
  animation: float3 2.5s ease-in-out infinite;
}

.banner-fire .banner-icon {
  animation: pulse 2s ease-in-out infinite;
}

.banner-fire .banner-btn text {
  color: #FF6B35;
}

.banner-gold {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  box-shadow: 0 8rpx 24rpx rgba(118, 75, 162, 0.35);
}

.banner-gold .decor-circle-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  opacity: 0.25;
  animation: shimmer 3s ease-in-out infinite;
}

.banner-gold .decor-circle-2 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  opacity: 0.2;
  animation: shimmer 4s ease-in-out infinite 0.5s;
}

.banner-gold .decor-circle-3 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  opacity: 0.15;
  animation: shimmer 3.5s ease-in-out infinite 1s;
}

.banner-gold .banner-icon {
  animation: glow 2s ease-in-out infinite;
}

.banner-gold .banner-btn text {
  color: #764ba2;
}

.banner-growth {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 50%, #56ab2f 100%);
  box-shadow: 0 8rpx 24rpx rgba(17, 153, 142, 0.35);
}

.banner-growth .decor-circle-1 {
  animation: float1 3.5s ease-in-out infinite;
}

.banner-growth .decor-circle-2 {
  animation: float2 4.5s ease-in-out infinite;
}

.banner-growth .decor-circle-3 {
  animation: float3 3s ease-in-out infinite;
}

.banner-growth .banner-icon {
  animation: bounce 2s ease-in-out infinite;
}

.banner-growth .banner-btn text {
  color: #11998e;
}

@keyframes float1 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-10rpx, 15rpx); }
}

@keyframes float2 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(15rpx, -10rpx); }
}

@keyframes float3 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-8rpx, -12rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes shimmer {
  0%, 100% { opacity: 0.15; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(1.05); }
}

@keyframes glow {
  0%, 100% { filter: drop-shadow(0 8rpx 16rpx rgba(255, 215, 0, 0.3)); }
  50% { filter: drop-shadow(0 8rpx 24rpx rgba(255, 215, 0, 0.6)); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.stats-section {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-num {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.checkin-item {
  cursor: pointer;
  transition: all 0.3s ease;
}

.checkin-item.checked {
  opacity: 0.6;
}

.checkin-item.checked .stats-label {
  color: #07C160;
}

.checkin-item:not(.checked):active {
  transform: scale(0.95);
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F0F0F0;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.quick-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.quick-count {
  font-size: 22rpx;
  color: #999;
}

.category-section {
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-text {
  font-size: 26rpx;
  color: #999;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
}

.category-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.practice-card {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  box-sizing: border-box;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 48rpx;
}

.card-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.card-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  margin-bottom: 8rpx;
}

.card-count {
  font-size: 22rpx;
  color: #999;
}
