page {
  background: #F6F7F9;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  box-sizing: border-box;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-action {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon.search {
  /* 放大镜是宽形构图，同尺寸下视觉偏小，加大一档与铃铛视觉等大 */
  width: 41rpx;
  height: 41rpx;
}

.action-icon.bell {
  width: 40rpx;
  height: 40rpx;
}

.msg-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 16rpx;
  height: 16rpx;
  background: #FA5151;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.main-scroll {
  flex: 1;
  margin-top: calc(88rpx + env(safe-area-inset-top));
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.continue-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.continue-content {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.continue-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.continue-desc {
  font-size: 24rpx;
  color: #999;
}

/* ===== 排行榜 Banner（静态，替代原轮播图） ===== */
.hero-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 240rpx;
  padding: 0 30rpx 0 40rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(100deg, #1E40B8 0%, #2456DB 55%, #2E6BF0 100%);
  box-shadow: 0 12rpx 28rpx -6rpx rgba(30, 64, 184, 0.45);
  overflow: hidden;
}

.hero-banner:active {
  transform: scale(0.99);
}

.hero-info {
  display: flex;
  flex-direction: column;
  z-index: 1;
  max-width: 62%;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin: 10rpx 0 22rpx;
}

.hero-btn {
  display: flex;
  align-items: center;
  align-self: flex-start;
  gap: 8rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.hero-btn text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E40B8;
}

.hero-chevron {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #1E40B8;
  border-right: 3rpx solid #1E40B8;
  transform: rotate(45deg);
}

.hero-img {
  width: 212rpx;
  height: 170rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.18));
}


.stats-section {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-num {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.checkin-item {
  cursor: pointer;
  transition: all 0.3s ease;
}

.checkin-item.checked {
  opacity: 0.6;
}

.checkin-item.checked .stats-label {
  color: #07C160;
}

.checkin-item:not(.checked):active {
  transform: scale(0.95);
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F0F0F0;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.quick-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.quick-count {
  font-size: 22rpx;
  color: #999;
}

.category-section {
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-text {
  font-size: 26rpx;
  color: #999;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
}

.category-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.practice-card {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  box-sizing: border-box;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 48rpx;
}

.card-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.card-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  margin-bottom: 8rpx;
}

.card-count {
  font-size: 22rpx;
  color: #999;
}
