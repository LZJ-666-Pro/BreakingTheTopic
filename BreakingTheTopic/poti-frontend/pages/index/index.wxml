<view class="page">
  <view class="header">
    <view class="header-left" bindtap="goToUser">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="user-name">{{userInfo.nickname || '面试鸭8384'}}</text>
    </view>
    <view class="header-right">
      <view class="header-action" bindtap="goToSearch">
        <image class="action-icon search" src="/images/s2.png" mode="aspectFit" />
      </view>
      <view class="header-action" bindtap="goToMessages">
        <image class="action-icon bell" src="/images/s1.png" mode="aspectFit" />
        <view class="msg-dot" wx:if="{{unreadCount > 0}}"></view>
      </view>
    </view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="continue-card" wx:if="{{hasUnfinished}}" bindtap="continuePractice">
      <van-icon name="play-circle-o" size="24px" color="#07C160" />
      <view class="continue-content">
        <text class="continue-title">继续上次练习</text>
        <text class="continue-desc">{{unfinishedCategory}} · 已完成 {{unfinishedProgress}}%</text>
      </view>
      <van-icon name="arrow" size="16px" color="#CCC" />
    </view>

    <!-- 排行榜 Banner（静态，替代原轮播图） -->
    <view class="hero-banner" bindtap="onBannerTap" data-type="rank">
      <view class="hero-info">
        <text class="hero-title">排行榜挑战</text>
        <text class="hero-desc">与全国用户PK，争夺周榜冠军</text>
        <view class="hero-btn">
          <text>查看排行</text>
          <view class="hero-chevron"></view>
        </view>
      </view>
      <image class="hero-img" src="/images/phb.png" mode="aspectFit" />
    </view>

    <view class="stats-section">
      <view class="stats-item">
        <text class="stats-num">{{todayCount}}</text>
        <text class="stats-label">今日</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-num">{{accuracy}}%</text>
        <text class="stats-label">正确率</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item checkin-item {{hasCheckedIn ? 'checked' : ''}}" bindtap="handleCheckIn">
        <text class="stats-num">{{streakDays}}</text>
        <text class="stats-label">{{hasCheckedIn ? '已签到' : '签到'}}</text>
      </view>
    </view>

    <view class="quick-grid">
      <view class="quick-item" bindtap="goToWrongbook">
        <van-icon name="warning-o" size="22px" color="#FA5151" />
        <text class="quick-name">错题本</text>
        <text class="quick-count">{{wrongCount}}</text>
      </view>
      <view class="quick-item" bindtap="goToFavorite">
        <van-icon name="star-o" size="22px" color="#FF9500" />
        <text class="quick-name">收藏</text>
        <text class="quick-count">{{favoriteCount}}</text>
      </view>
      <view class="quick-item" bindtap="randomPractice">
        <van-icon name="exchange" size="22px" color="#7B61FF" />
        <text class="quick-name">随机刷题</text>
        <text class="quick-count">{{totalQuestions}}</text>
      </view>
      <view class="quick-item" bindtap="goToHistory">
        <van-icon name="clock-o" size="22px" color="#1890FF" />
        <text class="quick-name">刷题记录</text>
        <text class="quick-count">{{historyCount}}</text>
      </view>
    </view>

    <view class="category-section">
      <view class="section-header">
        <text class="section-title">题库</text>
        <view class="section-more" bindtap="goToQuestion">
          <text class="more-text">全部</text>
          <van-icon name="arrow" size="14px" color="#999" />
        </view>
      </view>
      
      <view class="card-grid">
        <view class="practice-card" wx:for="{{displayCategories}}" wx:key="id" bindtap="selectCategory" data-type="{{item.type}}">
          <view class="card-icon-wrap" style="background: {{item.bgColor}}15;">
            <text class="card-icon">{{item.icon}}</text>
          </view>
          <text class="card-name">{{item.name}}</text>
          <text class="card-count">{{item.questionCount}}题</text>
        </view>
      </view>
      
      <view class="category-toggle" wx:if="{{categories.length > 8}}" bindtap="toggleCategories">
        <text>{{showAllCategories ? '收起' : '展开全部'}}</text>
        <van-icon name="{{showAllCategories ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#666" />
      </view>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
