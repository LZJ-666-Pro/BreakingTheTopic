.page {
  min-height: 100vh;
  background: #f8f9fa;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 40rpx;
  background: #fff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.placeholder {
  width: 60rpx;
}

.content {
  flex: 1;
  background: #f8f9fa;
  padding: 40rpx;
}

.tips-section {
  display: flex;
  align-items: center;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #ffd591;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #d48806;
  line-height: 1.5;
}

.form-section {
  margin-bottom: 60rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.input-group:focus-within {
  border-color: #1890ff;
}

.input-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 6rpx;
  margin-left: 20rpx;
  white-space: nowrap;
}

.send-code-btn.disabled {
  background: #ccc;
  color: #fff;
}

.toggle-password {
  font-size: 40rpx;
  padding: 10rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s;
}

.toggle-password:active {
  opacity: 0.6;
  transform: scale(0.9);
}

.reset-btn {
  width: 100%;
  height: 90rpx;
  background: #1890ff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  transition: all 0.3s;
}

.reset-btn.btn-loading {
  opacity: 0.7;
}

.reset-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.link-text {
  font-size: 28rpx;
  color: #999;
}

.link-btn {
  font-size: 28rpx;
  color: #1890ff;
  margin-left: 10rpx;
}
