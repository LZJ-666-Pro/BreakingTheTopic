.page {
  padding: 24rpx 32rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  background: #F7F8FA;
}

.page-hint {
  font-size: 23rpx;
  color: #98A0B3;
  margin: 4rpx 4rpx 20rpx;
}

.record-card {
  background: #fff;
  border: 2rpx solid #EEF0F5;
  border-radius: 20rpx;
  padding: 26rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
}

.record-top {
  display: flex;
  align-items: center;
}

.record-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-1 {
  color: #C79212;
  background: #F5F6F8;
}

.rank-2 {
  color: #8A94A6;
  background: #F5F6F8;
}

.rank-3 {
  color: #B0773D;
  background: #F5F6F8;
}

.rank-normal {
  color: #98A0B3;
  background: #F5F6F8;
}

.record-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 500;
  color: #1F2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-score {
  display: flex;
  align-items: baseline;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.score-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #6C47E0;
  font-variant-numeric: tabular-nums;
}

.score-unit {
  font-size: 22rpx;
  color: #98A0B3;
  margin-left: 4rpx;
}

.record-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #98A0B3;
  margin: 16rpx 0 0 64rpx;
}

.meta-dot {
  margin: 0 12rpx;
  color: #C8C9CC;
}

.record-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F2F4F7;
}

.foot-hint {
  font-size: 22rpx;
  color: #98A0B3;
}

.foot-arrow {
  font-size: 28rpx;
  color: #C8C9CC;
  margin-left: 6rpx;
  line-height: 1;
}

.load-tip {
  text-align: center;
  font-size: 23rpx;
  color: #C0C6D4;
  padding: 24rpx 0;
}

.empty-state {
  padding: 160rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  font-size: 26rpx;
  color: #98A0B3;
  margin-top: 24rpx;
}
