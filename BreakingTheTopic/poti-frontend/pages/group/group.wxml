<view class="page">
  <view class="header">
    <text class="header-title">加入交流群</text>
    <text class="header-desc">一个人维护的小项目，欢迎一起来刷题打卡、交流进步</text>
  </view>

  <!-- 空状态：交流群还没配置 -->
  <view class="section empty-box" wx:if="{{isEmpty}}">
    <view class="empty-icon">👥</view>
    <view class="empty-title">交流群还在筹备中</view>
    <view class="empty-desc">正式的交流群建好后会在这里公布，先去意见反馈提提建议也很欢迎</view>
    <view class="empty-btn" bindtap="goFeedback">去提意见反馈</view>
  </view>

  <view class="section" wx:if="{{groups.length > 0}}">
    <view class="section-title">QQ交流群</view>
    <view class="group-list">
      <view class="group-item" wx:for="{{groups}}" wx:key="id">
        <view class="group-left">
          <text class="group-name">{{item.name}}</text>
          <text class="group-qq" wx:if="{{item.qqNumber}}">群号：{{item.qqNumber}}</text>
        </view>
        <view class="copy-btn" data-qq="{{item.qqNumber}}" bindtap="copyQQNumber" wx:if="{{item.qqNumber}}">
          复制
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{wechatHelper}}">
    <view class="section-title">开发者微信</view>
    <view class="helper-box">
      <view class="helper-info">
        <text class="helper-name">添加开发者微信</text>
        <text class="helper-tip">备注"刷题"，一个人慢慢聊，看到就会回</text>
      </view>
      <view class="helper-action">
        <text class="wechat-id">{{wechatHelper}}</text>
        <view class="copy-btn" bindtap="copyWechat">
          复制
        </view>
      </view>
    </view>
  </view>

  <view class="tips-box" wx:if="{{groups.length > 0 || wechatHelper}}">
    <text class="tips-text">温馨提示：有问题或建议也可以直接走意见反馈，都会认真看</text>
  </view>
</view>
