.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.section {
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #999;
  margin-bottom: 20rpx;
}

.group-list {
  
}

.group-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.group-item:last-child {
  border-bottom: none;
}

.group-left {
  display: flex;
  flex-direction: column;
}

.group-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.group-qq {
  font-size: 26rpx;
  color: #999;
}

.copy-btn {
  font-size: 26rpx;
  color: #576b95;
  padding: 0;
  background: transparent;
}

.helper-box {
  padding: 24rpx 0;
}

.helper-info {
  margin-bottom: 16rpx;
}

.helper-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.helper-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.helper-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.wechat-id {
  font-size: 28rpx;
  color: #576b95;
}

.tips-box {
  padding: 32rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #bbb;
}
