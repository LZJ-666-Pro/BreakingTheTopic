<view class="page">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="title">手机号登录</text>
    <view class="placeholder"></view>
  </view>

  <view class="content">
    <view class="login-tabs">
      <view class="tab {{loginMode === 'password' ? 'active' : ''}}" bindtap="switchMode" data-mode="password">
        <text>密码登录</text>
      </view>
      <view class="tab {{loginMode === 'code' ? 'active' : ''}}" bindtap="switchMode" data-mode="code">
        <text>验证码登录</text>
      </view>
    </view>

    <view class="form-section">
      <view class="input-group">
        <input class="input-field" 
               type="number" 
               placeholder="请输入手机号" 
               value="{{phone}}"
               bindinput="onPhoneInput"
               maxlength="11"/>
      </view>

      <view class="input-group" wx:if="{{loginMode === 'password'}}">
        <input class="input-field" 
               password="{{!showPassword}}" 
               placeholder="请输入密码" 
               value="{{password}}"
               bindinput="onPasswordInput"/>
        <view class="toggle-password" catchtap="togglePassword">
          <text class="toggle-icon">{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>

      <view class="input-group code-group" wx:if="{{loginMode === 'code'}}">
        <input class="input-field" 
               type="number" 
               placeholder="请输入验证码" 
               value="{{verifyCode}}"
               bindinput="onVerifyCodeInput"
               maxlength="6"/>
        <view class="send-code-btn {{canSendCode ? '' : 'disabled'}}" bindtap="sendVerifyCode">
          <text>{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
        </view>
      </view>
    </view>

    <button class="login-btn {{loading ? 'btn-loading' : ''}}" 
            bindtap="handleLogin"
            disabled="{{loading}}">
      <text class="btn-text">{{loading ? '登录中...' : '登录'}}</text>
    </button>

    <view class="footer-links">
      <text class="link-btn" bindtap="goToForgotPassword">忘记密码</text>
      <text class="link-divider">|</text>
      <text class="link-btn" bindtap="goToRegister">立即注册</text>
    </view>
  </view>
</view>
