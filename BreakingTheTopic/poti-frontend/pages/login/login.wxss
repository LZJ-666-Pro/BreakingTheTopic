page {
  min-height: 100vh;
  background: #f8f9fa;
  -webkit-tap-highlight-color: transparent;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header-bg {
  background: linear-gradient(135deg, #2d3436 0%, #636e72 100%);
  padding: 80rpx 40rpx 100rpx;
  padding-top: calc(100rpx + env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 70%, rgba(255, 255, 255, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 40%);
}

.glass-icon {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border: none;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 1;
}

.glass-icon::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  background: linear-gradient(135deg, #2d3436 0%, #636e72 100%);
  border-radius: 26rpx;
}

.icon-emoji {
  font-size: 56rpx;
  position: relative;
  z-index: 2;
}

.main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.sub-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.content {
  flex: 1;
  padding: 48rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.welcome-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.welcome-emoji {
  font-size: 44rpx;
  display: block;
  margin-bottom: 12rpx;
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.welcome-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.privacy-capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 46, 0.04);
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 32rpx;
}

.capsule-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.capsule-tag {
  font-size: 24rpx;
  color: #666;
}

.capsule-dot {
  width: 6rpx;
  height: 6rpx;
  background: #ccc;
  border-radius: 50%;
  margin: 0 14rpx;
}

.wechat-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  border: 2rpx solid #333;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  transition: all 0.2s ease;
  padding: 0;
}

.wechat-btn::after {
  border: none;
}

.wechat-btn.btn-pressed {
  transform: scale(0.97);
  background: #f5f5f5;
}

.wechat-btn[disabled] {
  background: #fff;
  opacity: 0.85;
}

.btn-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.auxiliary-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.aux-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  transition: opacity 0.2s;
}

.aux-item:active {
  opacity: 0.5;
}

.aux-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.aux-text {
  font-size: 26rpx;
  color: #888;
}

.aux-item:first-child {
  margin-right: 32rpx;
}

.footer {
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #f8f9fa;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 24rpx;
  color: #bbb;
}

.agreement-link {
  font-size: 24rpx;
  color: #1a1a2e;
}

.custom-toast {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%) translateY(40rpx);
  background: rgba(0, 0, 0, 0.75);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  opacity: 0;
  transition: all 0.3s ease;
  z-index: 1000;
}

.custom-toast.toast-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.toast-text {
  font-size: 26rpx;
  color: #fff;
}
