<view class="page">
  <view class="header-bg">
    <view class="glass-icon">
      <text class="icon-emoji">📖</text>
    </view>
    <text class="main-title">破题</text>
    <text class="sub-title">刷题 · 成长 · 即刻启程</text>
  </view>

  <view class="content">
    <view class="welcome-section">
      <text class="welcome-emoji">👋</text>
      <text class="welcome-title">欢迎回来</text>
      <text class="welcome-desc">授权后即可使用完整服务</text>
    </view>

    <view class="privacy-capsule">
      <text class="capsule-icon">🔒</text>
      <text class="capsule-tag">严格保密</text>
      <text class="capsule-dot"></text>
      <text class="capsule-tag">微信一键登录</text>
    </view>

    <button class="wechat-btn {{btnPressed ? 'btn-pressed' : ''}}" 
            bindtap="handleLogin"
            bindtouchstart="onBtnStart"
            bindtouchend="onBtnEnd"
            disabled="{{loading}}">
      <text class="btn-icon">💬</text>
      <text class="btn-text">{{loading ? '获取授权信息...' : '微信用户一键登录'}}</text>
    </button>

    <view class="auxiliary-row">
      <view class="aux-item" bindtap="handlePhoneLogin">
        <text class="aux-icon">📱</text>
        <text class="aux-text">手机号登录</text>
      </view>
      <view class="aux-item" bindtap="goToRegister">
        <text class="aux-icon">📝</text>
        <text class="aux-text">注册账号</text>
      </view>
      <view class="aux-item" bindtap="handleGuestLogin">
        <text class="aux-icon">👤</text>
        <text class="aux-text">游客体验</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="agreement-row">
      <text class="agreement-text">登录即代表同意</text>
      <text class="agreement-link" bindtap="goToAgreement">《用户协议》</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link" bindtap="goToPrivacy">《隐私政策》</text>
    </view>
  </view>

  <view class="custom-toast {{toastShow ? 'toast-show' : ''}}" wx:if="{{toastMsg}}">
    <text class="toast-text">{{toastMsg}}</text>
  </view>
</view>
