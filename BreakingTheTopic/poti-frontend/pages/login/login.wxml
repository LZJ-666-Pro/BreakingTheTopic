<view class="page">
  <view class="hero">
    <view class="hero-icon">
      <text class="icon-emoji">📖</text>
    </view>
    <text class="main-title">破题</text>
    <text class="sub-title">刷题 · 成长 · 即刻启程</text>
  </view>

  <view class="content">
    <view class="welcome-section">
      <view class="welcome-row">
        <text class="welcome-emoji">👋</text>
        <text class="welcome-title">欢迎回来</text>
      </view>
      <text class="welcome-desc">一键登录，马上开始刷题</text>
    </view>

    <button class="wechat-btn {{btnPressed ? 'btn-pressed' : ''}}"
            bindtap="handleLogin"
            bindtouchstart="onBtnStart"
            bindtouchend="onBtnEnd"
            disabled="{{loading}}">
      <view class="btn-icon"></view>
      <text class="btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view class="auxiliary-row">
      <text class="aux-item" bindtap="handlePhoneLogin">手机号登录</text>
      <text class="aux-dot">·</text>
      <text class="aux-item" bindtap="goToRegister">注册账号</text>
      <text class="aux-dot">·</text>
      <text class="aux-item" bindtap="handleGuestLogin">游客体验</text>
    </view>
  </view>

  <view class="footer">
    <view class="agreement-row">
      <text class="agreement-text">登录即代表同意</text>
      <text class="agreement-link" bindtap="goToAgreement">《用户协议》</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link" bindtap="goToPrivacy">《隐私政策》</text>
    </view>
  </view>

  <view class="custom-toast {{toastShow ? 'toast-show' : ''}}" wx:if="{{toastMsg}}">
    <text class="toast-text">{{toastMsg}}</text>
  </view>
</view>
