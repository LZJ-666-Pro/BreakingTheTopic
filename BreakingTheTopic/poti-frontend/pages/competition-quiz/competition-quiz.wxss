page {
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FA;
  box-sizing: border-box;
}

.center-tip {
  padding: 200rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

/* ---------- 无法答题 ---------- */
.invalid-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.invalid-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.7;
  margin-bottom: 32rpx;
}

.invalid-text {
  font-size: 28rpx;
  color: #7A8194;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.invalid-btn {
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #2979FF, #7C4DFF);
}

/* ---------- 答题模式 ---------- */
.quiz-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.countdown {
  display: flex;
  align-items: baseline;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.countdown-label {
  font-size: 22rpx;
  color: #98A0B3;
  margin-right: 12rpx;
}

.countdown-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #2979FF;
  font-variant-numeric: tabular-nums;
}

.countdown.warning .countdown-time {
  color: #F56C6C;
}

.countdown.warning {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.55; }
  100% { opacity: 1; }
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A6478;
}

.progress-bar {
  height: 8rpx;
  background: #E8EBF2;
  border-radius: 8rpx;
  margin: 0 32rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #2979FF, #7C4DFF);
  transition: width 0.25s ease;
}

.quiz-scroll {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.q-type-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #7C4DFF;
  background: rgba(124, 77, 255, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.q-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
  line-height: 1.6;
  margin-top: 20rpx;
}

/* ---------- 选项 ---------- */
.options {
  margin-top: 28rpx;
}

.multi-hint {
  font-size: 22rpx;
  color: #98A0B3;
  margin-bottom: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #EEF0F5;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.option-item.selected {
  border-color: #2979FF;
  background: rgba(41, 121, 255, 0.06);
}

.option-letter {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F0F1F5;
  color: #5A6478;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-letter {
  background: linear-gradient(135deg, #2979FF, #7C4DFF);
  color: #fff;
}

.option-letter.multi {
  border-radius: 12rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* ---------- 填空题 / 解答题 ---------- */
.input-hint {
  font-size: 22rpx;
  color: #98A0B3;
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.blank-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #EEF0F5;
  border-radius: 12rpx;
  background: #FAFBFC;
  font-size: 28rpx;
  color: #1F2430;
}

.essay-input {
  width: 100%;
  height: 400rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #EEF0F5;
  border-radius: 12rpx;
  background: #FAFBFC;
  font-family: Menlo, Consolas, 'Courier New', monospace;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1F2430;
}

.blank-input:focus,
.essay-input:focus {
  border-color: #2979FF;
  background: #fff;
}

.input-placeholder {
  color: #C0C6D4;
}

/* ---------- 底部导航 ---------- */
.quiz-footer {
  display: flex;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.nav-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.nav-btn.prev {
  color: #5A6478;
  background: #F0F1F5;
  margin-right: 24rpx;
}

.nav-btn.prev.disabled {
  color: #C9CEDA;
}

.nav-btn.next {
  color: #fff;
  background: linear-gradient(135deg, #2979FF, #7C4DFF);
}

.nav-btn.submit {
  color: #fff;
  background: #6C47E0;
}

.nav-btn.disabled {
  opacity: 0.6;
}

/* ---------- 成绩模式 ---------- */
.result-scroll {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.result-card {
  border-radius: 20rpx;
  padding: 44rpx 32rpx 36rpx;
  background: #fff;
  border: 2rpx solid #EEF0F5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-label {
  font-size: 25rpx;
  color: #969799;
}

.result-score {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 8rpx 0 28rpx;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
}

.result-stats {
  display: flex;
  align-items: center;
  width: 100%;
  background: #F7F8FA;
  border-radius: 14rpx;
  padding: 20rpx 0;
}

.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.stat-name {
  font-size: 22rpx;
  color: #969799;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E8EAEF;
}

/* ---------- 排行榜 ---------- */
.rank-section {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.rank-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.rank-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
}

.rank-sub {
  font-size: 22rpx;
  color: #98A0B3;
  margin-left: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
}

.rank-item.me {
  background: #F7F4FE;
}

.rank-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-1 {
  color: #C79212;
  background: #F5F6F8;
}

.rank-2 {
  color: #8A94A6;
  background: #F5F6F8;
}

.rank-3 {
  color: #B0773D;
  background: #F5F6F8;
}

.rank-normal {
  color: #98A0B3;
  background: #F0F1F5;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #F0F1F5;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #1F2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: #6C47E0;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 8rpx;
}

.rank-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.rank-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #6C47E0;
}

.rank-cost {
  font-size: 22rpx;
  color: #98A0B3;
  margin-top: 4rpx;
}

.empty-state {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* ---------- 试卷回顾 ---------- */
.review-section {
  margin-top: 24rpx;
}

.review-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.review-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2430;
}

.review-sub {
  font-size: 22rpx;
  color: #98A0B3;
  margin-left: 16rpx;
}

.review-item {
  background: #fff;
  border: 2rpx solid #EEF0F5;
  border-radius: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  margin-bottom: 20rpx;
}

.review-q-head {
  display: flex;
  align-items: center;
}

.review-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: #F5F6F8;
  color: #5A6478;
  font-size: 23rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.review-type {
  font-size: 21rpx;
  color: #969799;
  background: #F5F6F8;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.review-flag {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.review-flag.ok {
  color: #3E7D5C;
  background: #EAF3EE;
}

.review-flag.bad {
  color: #B45454;
  background: #F9ECEC;
}

.review-flag.unknown {
  color: #969799;
  background: #F5F6F8;
}

.review-score {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  color: #6C47E0;
  flex-shrink: 0;
}

.review-q-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2430;
  line-height: 1.6;
  margin: 20rpx 0 6rpx;
}

/* 选择题回顾选项 */
.review-options {
  margin-top: 16rpx;
}

.review-opt {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid #EEF0F5;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.review-opt.correct {
  border-color: #A9CDB9;
  background: #F4FAF6;
}

.review-opt.wrong {
  border-color: #DFB3B3;
  background: #FCF4F4;
}

.review-opt-letter {
  font-size: 23rpx;
  font-weight: 600;
  color: #5A6478;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.review-opt.correct .review-opt-letter {
  color: #3E7D5C;
}

.review-opt.wrong .review-opt-letter {
  color: #B45454;
}

.review-opt-text {
  flex: 1;
  font-size: 25rpx;
  color: #464C5A;
  line-height: 1.5;
}

.review-opt-mark {
  flex-shrink: 0;
  font-size: 19rpx;
  color: #B45454;
  border: 2rpx solid #DFB3B3;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

/* 填空/解答回顾作答区 */
.review-answer {
  margin-top: 16rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.review-answer-row {
  display: flex;
  align-items: flex-start;
}

.review-answer-row + .review-answer-row {
  margin-top: 14rpx;
}

.answer-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #969799;
  line-height: 1.6;
  margin-right: 20rpx;
}

.answer-value {
  flex: 1;
  font-size: 24rpx;
  color: #1F2430;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.answer-value.mono {
  font-family: Menlo, Consolas, 'Courier New', monospace;
  font-size: 23rpx;
}

.answer-value.empty {
  color: #C0C6D4;
}

.answer-value.ref {
  color: #3E7D5C;
}

/* 解析 */
.review-analysis {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F2F4F7;
}

.analysis-label {
  display: block;
  font-size: 22rpx;
  color: #969799;
  margin-bottom: 8rpx;
}

.analysis-text {
  font-size: 24rpx;
  color: #646566;
  line-height: 1.7;
}
