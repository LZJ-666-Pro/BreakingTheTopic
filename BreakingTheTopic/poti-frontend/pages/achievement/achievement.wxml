<view class="page">
  <view class="header">
    <view class="achievement-summary">
      <view class="summary-item">
        <text class="summary-number">{{achievementSummary.total}}</text>
        <text class="summary-label">总成就</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-number achieved">{{achievementSummary.achieved}}</text>
        <text class="summary-label">已获得</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-number">{{achievementSummary.points}}</text>
        <text class="summary-label">成就点</text>
      </view>
    </view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="category-section">
      <view class="category-tabs">
        <view class="category-tab {{activeCategory === 'all' ? 'active' : ''}}" bindtap="switchCategory" data-category="all">
          <text>全部</text>
        </view>
        <view class="category-tab {{activeCategory === 'practice' ? 'active' : ''}}" bindtap="switchCategory" data-category="practice">
          <text>刷题成就</text>
        </view>
        <view class="category-tab {{activeCategory === 'social' ? 'active' : ''}}" bindtap="switchCategory" data-category="social">
          <text>社交成就</text>
        </view>
        <view class="category-tab {{activeCategory === 'special' ? 'active' : ''}}" bindtap="switchCategory" data-category="special">
          <text>特殊成就</text>
        </view>
      </view>
    </view>

    <view class="achievement-grid">
                  <view class="achievement-card {{item.achieved ? 'achieved' : 'locked'}}" 
                        wx:for="{{filteredAchievements}}" wx:key="id" 
                        bindtap="showAchievementDetail" data-achievement="{{item}}">
                    <view class="achievement-icon-wrap">
                      <text class="achievement-icon">{{item.icon}}</text>
                      <view class="achievement-badge" wx:if="{{item.achieved}}">✓</view>
                    </view>
                    <text class="achievement-name">{{item.name}}</text>
                    <text class="achievement-desc">{{item.description}}</text>
                    <view class="achievement-progress" wx:if="{{!item.achieved && item.progress}}">
                      <view class="progress-bar">
                        <view class="progress-fill" style="width: {{item.progress.percent}}%;"></view>
                      </view>
                      <text class="progress-text">{{item.progress.current}}/{{item.progress.total}}</text>
                      <text class="progress-hint" wx:if="{{item.hint}}">{{item.hint}}</text>
                    </view>
                    <view class="achievement-points" wx:if="{{item.achieved}}">
                      <text>+{{item.points}}点</text>
                    </view>
                  </view>
                </view>

    <view class="empty-state" wx:if="{{filteredAchievements.length === 0}}">
      <van-icon name="gem-o" size="60px" color="#ddd" />
      <text class="empty-text">暂无成就</text>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>

  <van-dialog use-slot title="{{currentAchievement.name}}" show="{{ showAchievementDialog }}" show-cancel-button="{{false}}" show-confirm-button="{{false}}" round>
                <view class="achievement-detail">
                  <view class="detail-icon">{{currentAchievement.icon}}</view>
                  <text class="detail-name">{{currentAchievement.name}}</text>
                  <text class="detail-desc">{{currentAchievement.description}}</text>
                  <view class="detail-status {{currentAchievement.achieved ? 'achieved' : 'locked'}}">
                    <text>{{currentAchievement.achieved ? '已获得' : '未获得'}}</text>
                  </view>
                  <view class="detail-reward" wx:if="{{currentAchievement.achieved}}">
                    <text class="reward-label">获得奖励：</text>
                    <text class="reward-points">+{{currentAchievement.points}} 成就点</text>
                  </view>
                  <view class="detail-progress" wx:if="{{!currentAchievement.achieved && currentAchievement.progress}}">
                    <text class="progress-label">完成进度：</text>
                    <view class="progress-bar-detail">
                      <view class="progress-fill-detail" style="width: {{currentAchievement.progress.percent}}%;"></view>
                    </view>
                    <text class="progress-text-detail">{{currentAchievement.progress.current}}/{{currentAchievement.progress.total}}</text>
                    <text class="progress-hint-detail" wx:if="{{currentAchievement.hint}}">{{currentAchievement.hint}}</text>
                  </view>
                  <view class="close-btn" bindtap="closeAchievementDialog">关闭</view>
                </view>
              </van-dialog>
</view>
