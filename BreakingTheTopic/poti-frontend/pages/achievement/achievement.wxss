.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 20rpx;
  background: #fff;
}

.achievement-summary {
  display: flex;
  align-items: center;
  background: #fafafa;
  border-radius: 8rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid #f0f0f0;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-number {
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
}

.summary-number.achieved {
  color: #333;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e0e0e0;
}

.main-scroll {
  height: calc(100vh - 180rpx);
  margin-top: 20rpx;
  background: #f5f5f5;
  border-radius: 32rpx 32rpx 0 0;
}

.category-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 32rpx 32rpx 0 0;
}

.category-tabs {
  display: flex;
  gap: 12rpx;
}

.category-tab {
  flex: 1;
  padding: 12rpx 0;
  background: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  border: 2rpx solid #e0e0e0;
}

.category-tab.active {
  background: #fff;
  color: #333;
  font-weight: 500;
  border-color: #333;
}

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 20rpx;
}

.achievement-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e8e8e8;
}

.achievement-card.achieved {
  border: 1rpx solid #333;
  background: #fff;
}

.achievement-card.locked {
  opacity: 0.7;
}

.achievement-card:active {
  transform: scale(0.98);
}

.achievement-icon-wrap {
  position: relative;
  margin-bottom: 16rpx;
}

.achievement-icon {
  font-size: 56rpx;
}

.achievement-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  background: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: #fff;
}

.achievement-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
  text-align: center;
}

.achievement-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.achievement-progress {
  width: 100%;
  margin-top: 8rpx;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: #333;
  border-radius: 3rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  display: block;
}

.progress-hint {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  display: block;
  margin-top: 8rpx;
}

.achievement-points {
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #333;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.achievement-detail {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.detail-status {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.detail-status.achieved {
  background: #f5f5f5;
  color: #333;
}

.detail-status.locked {
  background: #f0f0f0;
  color: #999;
}

.detail-reward {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.reward-label {
  font-size: 26rpx;
  color: #666;
}

.reward-points {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.detail-progress {
  width: 100%;
}

.progress-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.progress-bar-detail {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill-detail {
  height: 100%;
  background: #333;
  border-radius: 4rpx;
}

.progress-text-detail {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  display: block;
}

.progress-hint-detail {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  display: block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.close-btn {
  width: 100%;
  padding: 24rpx 0;
  margin-top: 32rpx;
  background: #fff;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  border: 2rpx solid #333;
}

.close-btn:active {
  opacity: 0.8;
}
