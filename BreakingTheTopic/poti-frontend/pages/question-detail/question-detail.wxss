.page {
  min-height: 100vh;
  background: #F5F6F8;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.content {
  padding-top: 108rpx;
  padding-bottom: 40rpx;
}

.question-card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.question-header {
  margin-bottom: 24rpx;
}

.question-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.question-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.difficulty-1 {
  background: #E8F5E9;
  color: #4CAF50;
}

.difficulty-2 {
  background: #FFF3E0;
  color: #FF9800;
}

.difficulty-3 {
  background: #FFEBEE;
  color: #F44336;
}

.type-tag {
  background: #E3F2FD;
  color: #2196F3;
}

.category-tag {
  background: #F3E5F5;
  color: #9C27B0;
}

.question-content {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.options-section {
  margin-top: 32rpx;
}

.options-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.option-item.selected {
  background: #F5F5F5;
  border-color: #333;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #333;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-item text {
  font-size: 24rpx;
  color: #666;
}

.action-item.active text {
  color: #FF9500;
}

.tabs {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #333;
  color: #fff;
  font-weight: 500;
}

.tab-content {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  min-height: 300rpx;
}

.show-answer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.show-answer-btn text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.answer-section {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.answer-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.answer-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.analysis-detail {
  margin-top: 32rpx;
}

.analysis-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1890FF;
}

.analysis-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  padding: 24rpx;
  background: #E6F7FF;
  border-radius: 12rpx;
}

.test-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.test-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.start-test-btn {
  padding: 28rpx 80rpx;
  background: #fff;
  border: 2rpx solid #333;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.start-test-btn:active {
  background: #F8F8F8;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-tip text {
  font-size: 28rpx;
  color: #999;
}

.empty-sub {
  font-size: 24rpx !important;
  color: #ccc !important;
}

.discussion-list {
  margin-bottom: 120rpx;
}

.discussion-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.discussion-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.discussion-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.discussion-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.discussion-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.discussion-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.discussion-more {
  padding: 10rpx;
  margin-right: -10rpx;
}

.discussion-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.discussion-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.action-btn.liked text {
  color: #FF6B6B;
}

.discussion-input {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.input-field {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #f5f6f8;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: #333;
  border-radius: 48rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.more-section {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.more-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.more-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.more-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.more-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.more-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
}

.more-content {
  flex: 1;
}

.more-question-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.more-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.more-type {
  font-size: 24rpx;
  color: #999;
}

.more-difficulty {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
