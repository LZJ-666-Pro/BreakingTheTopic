<view class="page">
  <view class="header">
    <view class="header-left">
      <text class="header-title">模拟面试</text>
      <text class="header-sub">选择方向，开始练习</text>
    </view>
    <view class="header-right" bindtap="viewHistory">
      <text class="history-text">历史</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{statistics.totalInterviews || 0}}</text>
      <text class="stat-name">面试次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{statistics.totalQuestions || 0}}</text>
      <text class="stat-name">答题数量</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{statistics.accuracy || 0}}%</text>
      <text class="stat-name">正确率</text>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">选择面试方向</text>
    </view>
    
    <view class="type-grid">
      <view class="type-card" wx:for="{{interviewTypes}}" wx:key="type" 
            bindtap="startInterview" data-type="{{item.type}}">
        <text class="type-emoji">{{item.emoji || '📝'}}</text>
        <text class="type-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view class="tips-card">
    <text class="tips-text">每场面试随机抽取10道题目，每题限时2分钟作答</text>
  </view>
</view>
