.page {
  min-height: 100vh;
  background: #f5f6f8;
}

.header {
  background: #fff;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.header-sub {
  font-size: 26rpx;
  color: #999;
}

.header-right {
  padding: 16rpx 28rpx;
  background: #f5f6f8;
  border-radius: 24rpx;
}

.history-text {
  font-size: 26rpx;
  color: #666;
}

.stats-card {
  display: flex;
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d3436;
}

.stat-name {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
  align-self: center;
}

.section {
  margin: 20rpx 24rpx;
}

.section-header {
  padding: 20rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 8rpx;
}

.type-card {
  width: 48%;
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.type-card:active {
  transform: scale(0.97);
  background: #fafafa;
}

.type-emoji {
  font-size: 40rpx;
}

.type-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
}

.tips-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tips-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
