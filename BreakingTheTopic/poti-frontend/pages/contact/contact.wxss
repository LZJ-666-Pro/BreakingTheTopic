.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.section {
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 48rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 18rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  background: #2979FF;
}

.section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #999;
  margin-bottom: 20rpx;
}

.contact-list {
  
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-left {
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.contact-value {
  font-size: 26rpx;
  color: #999;
}

.contact-copy {
  font-size: 26rpx;
  color: #576b95;
  padding: 0;
}

.work-box {
  padding: 24rpx 0;
}

.work-time {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.work-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
}
