page {
  background: #F5F7FA;
  height: 100%;
}

.agent-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx 0;
}

.history-btn {
  padding: 10rpx 24rpx;
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #6366F1;
}

.new-session-btn {
  padding: 10rpx 24rpx;
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #374151;
}

/* ===== 聊天记录弹层 ===== */
.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.history-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.history-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  border-radius: 50%;
}

.history-list {
  max-height: calc(70vh - 120rpx);
  padding: 0 24rpx;
  box-sizing: border-box;
}

.history-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9CA3AF;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.session-item:active {
  background: #F9FAFB;
}

.session-main {
  flex: 1;
  overflow: hidden;
}

.session-title {
  font-size: 28rpx;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.session-del {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #EF4444;
  background: #FEF2F2;
  border-radius: 24rpx;
}

.new-session-btn:active {
  background: #F3F4F6;
}

.msg-list {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.list-bottom {
  height: 40rpx;
}

/* 欢迎区 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 40rpx;
}

.welcome-badge {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 28rpx;
}

.welcome-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.welcome-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 26rpx;
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #374151;
}

.chip:active {
  background: #EEF2FF;
  border-color: #2979FF;
}

/* 消息行 */
.row {
  display: flex;
  margin-bottom: 28rpx;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
  align-items: flex-start;
}

.ai-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.bubble {
  max-width: 560rpx;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-user {
  background: #2979FF;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.bubble-ai {
  background: #fff;
  color: #1F2937;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble-failed {
  background: #FEF2F2;
  color: #B91C1C;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0 2rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9CA3AF;
  animation: dot-blink 1.2s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

.retry {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #2979FF;
  text-decoration: underline;
}

/* 引用标注 */
.sources {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.source-tag {
  font-size: 20rpx;
  color: #6B7280;
  background: #F3F4F6;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

/* 动作卡片 */
.actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: #EEF2FF;
  color: #2979FF;
  border: 1rpx solid #C7D2FE;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn:active {
  background: #E0E7FF;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #E5E7EB;
  gap: 16rpx;
}

.input {
  flex: 7;
  height: 72rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  flex: 2;
  height: 72rpx;
  border-radius: 12rpx;
  background: #C7D2FE;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn-active {
  background: #2979FF;
}
