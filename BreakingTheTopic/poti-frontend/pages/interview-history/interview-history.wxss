.page {
  min-height: 100vh;
  background: #F6F7F9;
}

.nav-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 32rpx 0;
  min-height: 44rpx;
}

.nav-clear {
  font-size: 28rpx;
  color: #8A94A6;
  padding: 8rpx 4rpx;
}

.list {
  padding: 16rpx 24rpx 40rpx;
}

.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(27, 43, 75, 0.10);
  transition: transform 0.15s ease;
}

.item:active {
  transform: scale(0.985);
}

.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-icon text {
  font-size: 44rpx;
}

.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1B2B4B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: 23rpx;
  color: #8A94A6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.item-detail {
  font-size: 23rpx;
  color: #2979FF;
  font-weight: 500;
}

.item-score {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.score-high {
  color: #22B573;
}

.badge-unfinished {
  font-size: 24rpx;
  font-weight: 600;
  color: #8A94A6;
  background: #F0F2F7;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.score-good {
  color: #2979FF;
}

.score-mid {
  color: #FF9F1C;
}

.score-low {
  color: #FA5151;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  background: #FFFBE6;
  border-radius: 20rpx;
}

.tip-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 25rpx;
  color: #8C7A2B;
  line-height: 1.7;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(27, 43, 75, 0.10);
}

.empty-icon text {
  font-size: 64rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #5A6478;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 25rpx;
  color: #8A94A6;
}
