<view class="page">
  <view class="nav-row">
    <text class="nav-clear" wx:if="{{list.length > 0}}" bindtap="clearAll">清空</text>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view class="item" wx:for="{{list}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}">
      <view class="item-icon" style="background:{{item.tint}};">
        <text>{{item.emoji}}</text>
      </view>
      <view class="item-body">
        <view class="item-title">{{item.title || '模拟面试'}}</view>
        <view class="item-meta">
          <text>{{item.dateText}} · {{item.totalQuestions}}题 · 用时{{item.spendText}}</text>
        </view>
      </view>
      <view class="item-right">
        <view class="item-score score-{{item.scoreLevel}}" wx:if="{{item.totalQuestions > 0}}">{{item.score}}%</view>
        <view class="badge-unfinished" wx:else>未完成</view>
        <view class="item-detail">查看详情 ›</view>
      </view>
    </view>

    <view class="tip-card">
      <text class="tip-icon">💡</text>
      <text class="tip-text">小提示：定期回顾面试记录，有助于发现薄弱环节，持续提升面试表现哦！</text>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon"><text>📋</text></view>
    <text class="empty-text">暂无面试记录</text>
    <text class="empty-tip">完成一场模拟面试，记录将显示在这里</text>
  </view>
</view>
