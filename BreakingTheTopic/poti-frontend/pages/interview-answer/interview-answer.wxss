.page {
  min-height: 100vh;
  background: #F6F7F9;
}

.page-head {
  background: #fff;
  padding: 28rpx 32rpx 30rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1B2B4B;
  margin-bottom: 20rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-num {
  font-size: 28rpx;
  color: #1B2B4B;
  font-weight: 600;
}

.num-hl {
  color: #2979FF;
}

.timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timer-icon {
  font-size: 26rpx;
}

.timer-text {
  font-size: 30rpx;
  color: #2979FF;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.timer.warning .timer-text {
  color: #FA5151;
  animation: blink 1s ease infinite;
}

@keyframes blink {
  50% { opacity: 0.45; }
}

.progress-track {
  height: 12rpx;
  background: #EDF0F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2979FF, #4A8DFF);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.content {
  padding: 24rpx 24rpx 200rpx;
}

.question-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(27, 43, 75, 0.10);
}

.question-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.q-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #EAF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.q-icon text {
  font-size: 28rpx;
}

.question-content {
  font-size: 30rpx;
  color: #1B2B4B;
  font-weight: 600;
  line-height: 1.7;
}

.answer-section {
  background: #fff;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(27, 43, 75, 0.10);
}

.answer-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.answer-icon {
  font-size: 30rpx;
}

.answer-title {
  font-size: 30rpx;
  color: #1B2B4B;
  font-weight: 600;
}

.answer-tabs {
  display: flex;
  background: #F0F2F7;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #8A94A6;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-mic {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.tab.active {
  color: #2979FF;
  background: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(27, 43, 75, 0.15);
}

.answer-content {
  position: relative;
}

.answer-input {
  width: 100%;
  height: 340rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  padding: 24rpx;
  background: #F7F8FA;
  border: 1rpx solid #EDF0F5;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.answer-placeholder {
  color: #B0B8C4;
}

.char-count {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #B0B8C4;
  background: rgba(247, 248, 250, 0.9);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.voice-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.voice-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2979FF 0%, #4A8DFF 100%);
  box-shadow: 0 12rpx 28rpx -8rpx rgba(41, 121, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #FA5151 0%, #FF7A7A 100%);
  box-shadow: 0 12rpx 28rpx -8rpx rgba(250, 81, 81, 0.45);
  transform: scale(1.08);
}

.voice-icon {
  font-size: 56rpx;
}

.voice-tip {
  font-size: 28rpx;
  color: #5A6478;
  margin-top: 24rpx;
}

.voice-duration {
  font-size: 26rpx;
  color: #8A94A6;
  margin-top: 12rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 22rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -4rpx 20rpx -8rpx rgba(27, 43, 75, 0.10);
  z-index: 10;
}

.btn-skip {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1B2B4B;
  background: #F0F2F7;
  border-radius: 20rpx;
  font-weight: 500;
}

.btn-skip:active {
  background: #E4E8EF;
}

.btn-submit {
  flex: 1.6;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #2979FF 0%, #4A8DFF 100%);
  border-radius: 20rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx -8rpx rgba(41, 121, 255, 0.45);
}

.btn-submit:active {
  transform: scale(0.98);
}

.btn-submit.disabled {
  background: #C4CBD8;
  box-shadow: none;
  color: #fff;
}
