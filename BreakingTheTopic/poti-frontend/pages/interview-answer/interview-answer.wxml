<view class="page">
  <view class="header">
    <view class="header-left">
      <text class="question-num">第 {{currentOrder}}/{{totalQuestions}} 题</text>
    </view>
    <view class="timer {{isWarning ? 'warning' : ''}}">
      <text class="timer-icon">⏱</text>
      <text class="timer-text">{{timerText}}</text>
    </view>
  </view>

  <view class="progress-bar">
    <view class="progress-fill" style="width: {{progress}}%;"></view>
  </view>

  <view class="content">
    <view class="question-card">
      <view class="question-content">{{currentQuestion.content}}</view>
    </view>

    <view class="answer-section">
      <view class="answer-header">
        <text class="answer-title">你的回答</text>
      </view>

      <view class="answer-tabs">
        <view class="tab {{answerMode === 'text' ? 'active' : ''}}" bindtap="switchMode" data-mode="text">
          <text>文字输入</text>
        </view>
        <view class="tab {{answerMode === 'voice' ? 'active' : ''}}" bindtap="switchMode" data-mode="voice">
          <text>语音回答</text>
        </view>
      </view>

      <view class="answer-content" wx:if="{{answerMode === 'text'}}">
        <textarea class="answer-input" 
                  placeholder="请输入你的答案..." 
                  value="{{userAnswer}}"
                  bindinput="onAnswerInput"
                  maxlength="1000"
                  auto-height />
        <view class="char-count">{{userAnswer.length}}/1000</view>
      </view>

      <view class="voice-section" wx:if="{{answerMode === 'voice'}}">
        <view class="voice-btn {{isRecording ? 'recording' : ''}}" bindtouchstart="startRecord" bindtouchend="stopRecord">
          <text class="voice-icon">{{isRecording ? '⏹' : '🎤'}}</text>
        </view>
        <text class="voice-tip">{{isRecording ? '松开结束录音' : '按住开始录音'}}</text>
        <text class="voice-duration" wx:if="{{recordDuration > 0}}">已录制 {{recordDuration}} 秒</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="btn-skip" bindtap="skipQuestion">跳过此题</view>
    <view class="btn-submit {{canSubmit ? '' : 'disabled'}}" bindtap="submitAnswer">
      {{isLastQuestion ? '完成面试' : '提交答案'}}
    </view>
  </view>
</view>
