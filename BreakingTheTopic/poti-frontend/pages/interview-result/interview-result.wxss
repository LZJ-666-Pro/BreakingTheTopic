.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 140rpx;
}

.header {
  background: #fff;
  padding: 32rpx;
  text-align: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.empty-wrap {
  padding: 40rpx 24rpx;
}

.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 24rpx -10rpx rgba(27, 43, 75, 0.10);
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: #F6F7F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon text {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1B2B4B;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8A94A6;
  line-height: 1.7;
}

.result-card {
  background: #fff;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-section {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #2d3436;
  line-height: 1;
}

.score-unit {
  font-size: 32rpx;
  color: #999;
  margin-left: 8rpx;
}

.score-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx 16rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3436;
}

.stat-value.correct {
  color: #2d3436;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

.feedback-card {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx 32rpx;
}

.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.feedback-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.detail-card {
  background: #fff;
}

.detail-card .card-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-list {
  padding: 0 32rpx;
}

.detail-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.item-num.correct {
  background: #2d3436;
  color: #fff;
}

.item-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.item-status.correct {
  color: #2d3436;
  background: #f0f0f0;
}

.item-status.wrong {
  color: #e74c3c;
  background: #fff0f0;
}

.item-question {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.item-answer {
  background: #f5f6f8;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.item-answer.skip {
  background: #fff0f0;
}

.answer-label {
  font-size: 24rpx;
  color: #999;
}

.answer-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.skip-text {
  font-size: 26rpx;
  color: #e74c3c;
}

.item-comment {
  background: #f5f6f8;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
}

.comment-label {
  font-size: 24rpx;
  color: #999;
}

.comment-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-back {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 44rpx;
}

.btn-retry {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #2d3436;
  border-radius: 44rpx;
  font-weight: 500;
}
