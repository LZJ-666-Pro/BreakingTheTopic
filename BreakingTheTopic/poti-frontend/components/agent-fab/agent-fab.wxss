.fab-wrap {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 999;
}

/* 与 agent 页 ai-avatar / 首页快捷卡统一：agent.png + 浅灰蓝底圆 */
.fab-ball {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8ECF5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(100, 116, 139, 0.25);
}

.fab-icon {
  width: 56rpx;
  height: 56rpx;
}

.fab-close {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}
