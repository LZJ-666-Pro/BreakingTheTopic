.fab-wrap {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 999;
}

.fab-ball {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.4);
}

.fab-close {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}
