.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 56px;
  background: #fff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 0.5px solid #EFEFEF;
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding-top: 7px;
}

.tab-bar-icon {
  width: 26px;
  height: 26px;
}

.tab-bar-text {
  margin-top: 2px;
  font-size: 11px;
  font-weight: 500;
  color: #9CA3AF;
  line-height: 1;
}

.tab-bar-text.active {
  color: #2979FF;
  font-weight: 600;
}
